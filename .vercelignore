# Exclude runtime/artifact files from the Vercel deployment bundle.
# The serverless entry api/index.py uses local/ + data/loader.py +
# pipeline/chunker.py. The production FastAPI app (main.py, chromadb-based
# indexer, retrieval/, llm/) is excluded so Vercel runs ONLY the serverless
# function — chromadb cannot run on Vercel's read-only filesystem.
.git/
.gitignore
Dockerfile
docker-compose.yml
README.md
chroma_db/
ollama_data/
__pycache__/
*.pyc
.venv/
venv/
node_modules/
main.py
pipeline/indexer.py
retrieval/
llm/

